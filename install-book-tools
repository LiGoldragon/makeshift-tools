#!/usr/bin/env python3
"""Install the book commands from a chosen checkout into a chosen PATH directory."""
import argparse
from pathlib import Path
import shlex

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("bin_directory", type=Path)
parser.add_argument("--repository", type=Path, default=Path(__file__).resolve().parent)
parser.add_argument("--babashka", default="bb")
args = parser.parse_args()
repository = args.repository.resolve()
commands = {name: repository / (name + ".clj")
            for name in ("book-tools", "book-build", "book-check")}
for source in commands.values():
    if not source.is_file():
        parser.error(f"Missing source: {source}")
args.bin_directory.mkdir(parents=True, exist_ok=True)
for name, source in commands.items():
    target = args.bin_directory / name
    if target.is_symlink():
        parser.error(f"Refusing to replace symlink: {target}")
    target.write_text("#!/bin/sh\nexec " + shlex.quote(args.babashka) + " "
                      + shlex.quote(str(source)) + ' "$@"\n')
    target.chmod(0o755)
    print(target)
